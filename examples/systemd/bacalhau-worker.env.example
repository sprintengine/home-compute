# A MagicDNS name or Tailnet IP. Include the nats:// scheme and port.
BACALHAU_ORCHESTRATOR=nats://orchestrator.example-tailnet.ts.net:4222
BACALHAU_TOKEN=replace-with-the-same-long-random-token

# Keep capacity available for interactive use of the computer.
BACALHAU_CPU=50%
BACALHAU_MEMORY=50%
BACALHAU_DISK=20%
