# Required by home-compute.example.json. Generate a long random value and use
# the same value in the Sprint Engine Studio module's connection settings.
HOME_COMPUTE_API_TOKEN=replace-with-a-long-random-value

# Optional: tailnet logins (comma-separated) the dashboard admits through
# `tailscale serve` without the token, e.g. you@example.com.
HOME_COMPUTE_DASHBOARD_LOGINS=
