// hc-web: the dashboard and the human API, behind a Cloudflare Access application.
// See README.md for local development and the deploy steps.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hc-web",
  "main": "src/hc-web.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // No per-version preview URLs: each would be one more public hostname.
  "preview_urls": false,
  // The dashboard folder is served as it is. Requests that match no file
  // (/v1/*, and /assets/*, which the page asks for) reach the Worker.
  "assets": { "directory": "../dashboard", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-compute",
      // Replace with the id `wrangler d1 create home-compute` prints. Local dev ignores it.
      "database_id": "4733103a-34c8-4bfe-b81b-136c0e729713",
      "migrations_dir": "migrations"
    }
  ],
  // hc-core's Dispatcher entrypoint (not a public route): Run now, Cancel and Retry on a
  // Cloudflare job start or stop its container at once rather than at the next cron minute.
  "services": [{ "binding": "HC_CORE", "service": "hc-core", "entrypoint": "Dispatcher" }]
  // Secrets (wrangler secret put NAME -c wrangler.web.jsonc; locally .dev.vars), kept out of
  // this file because they are either secret or the owner's own. A plain var of the same
  // name cannot exist: wrangler deploy replaces vars from this file, and secrets survive it.
  //   CSRF_KEY            32+ random bytes for the dashboard's CSRF tokens.
  //   BOOTSTRAP_ADMINS    comma-separated emails that are admins before any `roles` setting exists.
  //   CORE_URL            hc-core's URL, shown in the enrol command that comes with a join token.
  //   VAULT_PUBLIC_KEY    the vault's RSA-OAEP public key (SPKI, base64); hc-web can only encrypt.
  //   ACCESS_TEAM_DOMAIN  the Access team hostname (`<team>.cloudflareaccess.com`). A pasted URL is accepted: any scheme and trailing slashes are stripped, and the issuer is `https://<host>`.
  //   ACCESS_AUD          the Access application's AUD tag.
}
