// hc-core: the agent API (/agent/v1/*) and the per-minute cron. It never serves people,
// and Access must never be put in front of it: agents authenticate with their own credentials.
// See README.md for local development and the deploy steps.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hc-core",
  "main": "src/hc-core.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // No per-version preview URLs: each would be one more public hostname.
  "preview_urls": false,
  // One of the account's five cron triggers. Changes take up to 15 minutes to propagate.
  "triggers": { "crons": ["* * * * *"] },
  // Alert emails (src/alerts.mjs) through Email Routing: only to verified destination addresses,
  // from an address on a zone with Email Routing on. The addresses are secrets (below).
  "send_email": [{ "name": "ALERT_EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-compute",
      "database_id": "4733103a-34c8-4bfe-b81b-136c0e729713",
      "migrations_dir": "migrations"
    }
  ],
  // The cron's logs and each container's full output (the dashboard keeps the last 500 lines).
  // Workers Paid includes 20 million log events a month; traces stay off.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  // Cloudflare Containers (docs/cloudflare-containers.md). One class per instance type, each with
  // the same image; a run goes to the smallest deployed class its memory and disk fit. Only `basic`
  // (1/4 vCPU, 1 GiB, 4 GB) is deployed: to add one, copy the entry and its binding, for example
  // HcContainerLite / HC_CONTAINER_LITE / "lite", and add the class to a new migration tag.
  // `image` and vars.HC_CONTAINER_IMAGE must name the same registry.cloudflare.com digest:
  // cloud/scripts/set-container-image.sh writes both, then `npx wrangler deploy -c wrangler.core.jsonc`.
  // max_instances is the hard cap; keep it equal to settings.cloudflare.maxConcurrent (2 here; the setting defaults to 1).
  "containers": [
    {
      "class_name": "HcContainerBasic",
      "image": "registry.cloudflare.com/29e356a26664bc14b4e5fd88cf533433/wingfoil-forecast@sha256:d1e6d39bd5a6c9a79e9fd91461aca38b2149837243709ff2b45d6c6284a4bc05",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HC_CONTAINER_BASIC", "class_name": "HcContainerBasic" }]
  },
  "migrations": [{ "tag": "v1-cloudflare-containers", "new_sqlite_classes": ["HcContainerBasic"] }],
  "vars": {
    // Empty until a real image is deployed: until then a Cloudflare job's run fails with how to set it.
    "HC_CONTAINER_IMAGE": "registry.cloudflare.com/29e356a26664bc14b4e5fd88cf533433/wingfoil-forecast@sha256:d1e6d39bd5a6c9a79e9fd91461aca38b2149837243709ff2b45d6c6284a4bc05",
    // The image the deployed one was copied from (its multi-platform ghcr digest): a job pinned to it runs here.
    "HC_CONTAINER_SOURCE": "ghcr.io/sprintengine/wingfoil-forecast@sha256:3e751ae835cd5e85e5b516d29ddcdaa4cc783615b5d296c99a50f6d1d5f6353a"
  }
  // Secrets (wrangler secret put NAME -c wrangler.core.jsonc), kept out of this file:
  //   VAULT_PRIVATE_KEY    the vault's RSA-OAEP private key (PKCS #8, base64); only hc-core can open secrets.
  //   ALERT_EMAIL_TO       the verified Email Routing destination alerts go to (the owner).
  //   ALERT_EMAIL_FROM     the sender, on a zone with Email Routing enabled.
  //   DASHBOARD_URL        hc-web's URL, linked from alert emails.
}
