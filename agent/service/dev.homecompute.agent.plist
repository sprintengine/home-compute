<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Home Compute agent as a LaunchAgent in the user's GUI domain (§4.7 of
  docs/hosted-control-plane.md). A template: replace @HOME@ with the user's
  home directory, save it as ~/Library/LaunchAgents/dev.homecompute.agent.plist, then
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.homecompute.agent.plist

  - PATH finds colima and docker (Homebrew on Apple silicon, then Intel).
  - AbandonProcessGroup: the Colima VM the agent starts must outlive an agent
    restart (the next start adopts its containers); without it launchd would
    end the VM's processes with the agent's.
  - ProcessType Standard: Background would lower the QoS of the agent and of
    the VM it starts, which may confine imports to efficiency cores (§12).
  - A LaunchAgent needs the user logged in; a headless Mac needs automatic
    login, which FileVault prevents (§12, risk 5).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.homecompute.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/Library/Application Support/home-compute/node/bin/node</string>
    <string>@HOME@/Library/Application Support/home-compute/agent/current/home-compute-agent.mjs</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/home-compute/agent.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/home-compute/agent.log</string>
</dict>
</plist>
